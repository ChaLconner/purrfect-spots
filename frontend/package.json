{
  "name": "purrfect-spots-frontend",
  "private": true,
  "version": "3.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.15 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build && node scripts/compress-brotli.mjs",
    "build:prod": "npx cross-env NODE_OPTIONS=--max-old-space-size=4096 vue-tsc && npx cross-env NODE_OPTIONS=--max-old-space-size=4096 vite build --mode production && node scripts/compress-brotli.mjs",
    "build:budget": "node scripts/check-bundle-budget.mjs",
    "build:analyze": "vite build --mode production && npx source-map-explorer dist/assets/js/*.js",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "test:e2e": "playwright test --tsconfig tsconfig.e2e.json",
    "test:e2e:headed": "playwright test --tsconfig tsconfig.e2e.json --headed",
    "test:e2e:ui": "playwright test --tsconfig tsconfig.e2e.json --ui",
    "test:all": "npm run test && npm run test:e2e",
    "lint": "eslint src --fix",
    "lint:check": "eslint src",
    "format": "prettier --write src/**/*.{ts,vue,css}",
    "deploy": "vercel --prod",
    "deploy:preview": "vercel",
    "generate-api": "npx openapi-typescript ../docs/openapi-baseline.json -o src/generated/api.ts",
    "generate-api:remote": "npx openapi-typescript http://127.0.0.1:8000/openapi.json -o src/generated/api.ts"
  },
  "dependencies": {
    "@googlemaps/markerclusterer": "^2.6.2",
    "@sentry/vue": "^10.69.0",
    "@supabase/supabase-js": "^2.118.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vue/devtools-api": "^8.2.1",
    "axios": "^1.20.0",
    "date-fns": "4.4.0",
    "dompurify": "^3.4.17",
    "pinia": "4.1.0",
    "tailwindcss": "^4.3.3",
    "vue": "3.5.44",
    "vue-i18n": "^11.4.16",
    "vue-router": "5.4.0",
    "vue-virtual-scroller": "3.0.5",
    "web-vitals": "^6.2.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@pinia/testing": "^2.0.2",
    "@playwright/test": "^1.64.1",
    "@types/google.maps": "^3.66.7",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.0.5",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-plugin-security": "^4.2.0",
    "eslint-plugin-vue": "^10.11.1",
    "jsdom": "^30.1.3",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "svgo": "^4.0.2",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.0",
    "vite": "8.3.5",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-image-optimizer": "^2.0.3",
    "vitest": "^5.0.0",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.13"
  }
}
