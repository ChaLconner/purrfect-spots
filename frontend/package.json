{
  "name": "purrfect-spots-frontend",
  "private": true,
  "version": "3.1.0",
  "type": "module",
  "engines": {
    "node": ">=24 <26"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "build:prod": "NODE_OPTIONS=--max-old-space-size=4096 vue-tsc && NODE_OPTIONS=--max-old-space-size=4096 vite build --mode production",
    "build:analyze": "vite build --mode production && npx source-map-explorer dist/assets/js/*.js",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "npm run test && npm run test:e2e",
    "lint": "eslint src --fix",
    "lint:check": "eslint src",
    "format": "prettier --write src/**/*.{ts,vue,css}",
    "deploy": "vercel --prod",
    "deploy:preview": "vercel",
    "generate-api": "npx openapi-typescript http://127.0.0.1:8000/openapi.json -o src/types/api.ts"
  },
  "dependencies": {
    "@googlemaps/js-api-loader": "^2.1.1",
    "@googlemaps/markerclusterer": "^2.6.2",
    "@sentry/vue": "^10.69.0",
    "@supabase/supabase-js": "^2.111.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/dompurify": "^3.2.0",
    "axios": "^1.19.0",
    "date-fns": "4.4.0",
    "dompurify": "^3.4.12",
    "follow-redirects": "1.16.0",
    "lodash": "4.18.1",
    "pinia": "3.0.4",
    "tailwindcss": "^4.3.2",
    "vue": "^3.5.40",
    "vue-i18n": "^11.4.8",
    "vue-router": "5.2.0",
    "vue-virtual-scroller": "3.0.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@pinia/testing": "^1.0.3",
    "@playwright/test": "^1.62.0",
    "@types/google.maps": "^3.65.3",
    "@types/lodash": "^4.17.24",
    "@types/node": "^26.1.2",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-vue": "^10.10.0",
    "jsdom": "^29.1.1",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.6",
    "sharp": "^0.35.3",
    "svgo": "^4.0.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-image-optimizer": "^2.0.3",
    "vitest": "^4.1.9",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.8"
  }
}
