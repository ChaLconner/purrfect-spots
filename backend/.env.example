# ================================
# BACKEND ENV EXAMPLE - Purrfect Spots
# ================================

# --- Server ---
PORT=8000
DEBUG=False
ENVIRONMENT=development

# --- Authentication ---
GOOGLE_CLIENT_ID=your_client_id_here
GOOGLE_CLIENT_SECRET=your_client_secret_here
JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here

# --- Database (Supabase) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
DATABASE_URL=postgresql://postgres.your-project-ref:your_database_password@aws-0-your-region.pooler.supabase.com:5432/postgres

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
FRONTEND_URL=http://localhost:5173
TRUSTED_PROXY_HOSTS=127.0.0.1,::1

# --- AWS S3 ---
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_REGION=your_region_here
AWS_S3_BUCKET=your_bucket_here
AWS_ACCOUNT_ID=your_account_id_here

# --- Google APIs ---
GOOGLE_VISION_API_KEY=your_vision_key_here
GOOGLE_VISION_KEY_PATH=keys/google_vision.json
# Preferred for serverless deployment: full service-account JSON on one line.
GOOGLE_VISION_SERVICE_ACCOUNT=
GOOGLE_MAPS_API_KEY=your_maps_key_here

# --- Sentry ---
SENTRY_DSN=your_sentry_dsn_here
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- EMAIL (Resend) ---
SMTP_SERVER=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=your_resend_password_here
SMTP_SENDER="Purrfect Spots <noreply@mail.purrfectspots.xyz>"

# --- REDIS ---
REDIS_URL=your_redis_url_here
# Dedicated Redis Streams storage for durable external-work jobs. In production
# this should use a no-eviction Redis instance separate from cache/rate limits.
QUEUE_REDIS_URL=your_queue_redis_url_here
ENABLE_STRIPE_WEBHOOK_QUEUE=false
ENABLE_VISION_ANALYSIS_QUEUE=false
QUEUE_MAX_ATTEMPTS=5
QUEUE_VISIBILITY_TIMEOUT_SECONDS=60
QUEUE_RESULT_TTL_SECONDS=1800
QUEUE_STREAM_MAXLEN=10000
VISION_QUEUE_MAX_IMAGE_BYTES=5242880
# Skip blocking Redis probe during import; set true only for fail-fast startup diagnostics.
RATE_LIMITER_STARTUP_PING=false
# Reconcile Stripe subscription state when webhook delivery is delayed or lost.
ENABLE_SUBSCRIPTION_RECONCILIATION=false
SUBSCRIPTION_RECONCILIATION_INTERVAL_SECONDS=900

# --- Database pool (per worker) ---
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_CONNECT_TIMEOUT=15
DB_COMMAND_TIMEOUT=60

# --- Stripe ---
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=your_webhook_secret_here
STRIPE_PRO_PRICE_ID=your_subscription_price_id_here
STRIPE_PRO_ANNUAL_PRICE_ID=your_annual_subscription_price_id_here

# --- Quota Configuration ---
QUOTA_FREE_LIMIT=2
QUOTA_PRO_LIMIT=30

# Treat Price IDs
STRIPE_TREAT_SMALL_PRICE_ID=your_price_id_here
STRIPE_TREAT_MEDIUM_PRICE_ID=your_price_id_here
STRIPE_TREAT_LARGE_PRICE_ID=your_price_id_here
STRIPE_TREAT_LEGENDARY_PRICE_ID=your_price_id_here

# --- Health / Ops ---
EXPOSE_DETAILED_HEALTH=false
HEALTH_READINESS_CACHE_ENABLED=true
