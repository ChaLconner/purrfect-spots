{
  "name": "@purrfect-spots/api-client",
  "version": "1.0.0",
  "private": true,
  "description": "TypeScript API client generator from OpenAPI spec",
  "scripts": {
    "generate": "npx openapi-typescript ../../docs/openapi-baseline.json -o ../../frontend/src/generated/api.ts",
    "validate": "npx @openapitools/openapi-generator-cli validate -i ../../docs/openapi-baseline.json"
  },
  "devDependencies": {
    "@openapitools/openapi-generator-cli": "^2.39.1"
  }
}
